# Copy to .env and fill in. Auth is Application Default Credentials:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Vertex region; newest Gemini models are usually served from "global"
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
# minimal | low | medium | high (blank = model default, high; --think forces high).
# medium: at the default several pilot replies spent the whole token cap thinking.
VERTEX_THINKING_LEVEL=medium
# Optional: cap on reply + thinking tokens
VERTEX_MAX_OUTPUT_TOKENS=32768
# Optional: USD per 1M tokens, for cost in the run reports (thinking is billed as output).
# Gemini 3.8 Flash introductory paid tier, through 2026-12-31:
VERTEX_PRICE_INPUT_PER_M=0.75
VERTEX_PRICE_OUTPUT_PER_M=3.75
